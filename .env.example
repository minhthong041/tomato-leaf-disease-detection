# Biến môi trường cho Docker Compose. Chép thành .env (cùng thư mục với docker-compose.yml) rồi sửa:
#     Copy-Item .env.example .env        (PowerShell)
#     cp .env.example .env               (Linux/macOS)
# Không có .env thì docker-compose.yml dùng giá trị mặc định, đủ để chạy thử trên máy.
# File .env chứa mật khẩu nên không commit.

# Cổng mở giao diện: http://localhost:8080
WEB_PORT=8080

# Database (PostgreSQL trong container db)
DB_NAME=tomato_leaf_disease_db
DB_USER=postgres
DB_PASSWORD=doi_mat_khau_database

# Django
# Tạo key mới: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=nhap_secret_key_vao_day
DJANGO_DEBUG=False
# Thêm IP máy nếu mở từ máy khác trong mạng, ví dụ localhost,127.0.0.1,192.168.1.10
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TERMS_VERSION=1.0

# Tài khoản quản trị tạo tự động khi khởi động (để trống thì không tạo; tạo tay bằng:
#     docker compose exec backend python manage.py createsuperuser)
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_FULLNAME=Quản trị viên
